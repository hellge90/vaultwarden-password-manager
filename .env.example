# Stable official release verified on 2026-10-01; the published image includes
# linux/arm64. Change only to another verified stable ARM64-capable release.
VAULTWARDEN_IMAGE=vaultwarden/server:1.37.3
# The installer writes your Pi's actual Tailscale HTTPS URL into .env.
VAULTWARDEN_DOMAIN=https://replace-with-your-pi.tailnet-name.ts.net
SIGNUPS_ALLOWED=false
